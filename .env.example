# =============================================================================
# PUBLIC env vars (VITE_*) — bundled into the browser. Never put secrets here.
# =============================================================================

# App display name
VITE_APP_NAME=PINNACLE AI

# Canonical site URL — used for SEO meta tags, sitemap, OG tags (no trailing slash).
VITE_SITE_URL=https://pinnxai.com

# Formspree form ID — from https://formspree.io/forms (the part after /f/ in your form URL).
# Set the form notification email to contact@pinnxai.com in the Formspree dashboard.
VITE_FORMSPREE_FORM_ID=mzdlannk

# Optional: override the contact submit URL (e.g. /api/contact proxy). Leave blank to use Formspree directly.
VITE_CONTACT_API_URL=

# Cloudflare Turnstile site key (public, safe to expose). Leave blank to disable captcha in dev.
# Test key (always passes): 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

# Plausible Analytics domain (the data-domain registered in Plausible).
# Leave blank to disable analytics entirely.
VITE_PLAUSIBLE_DOMAIN=

# Sentry DSN for client-side error tracking.
# Leave blank to disable Sentry entirely.
VITE_SENTRY_DSN=

# =============================================================================
# SERVER-ONLY env vars (no VITE_ prefix). Set in Vercel project settings if using /api/contact.
# Never commit secrets. Never expose to the browser.
# =============================================================================

# Same Formspree form ID — only needed when using the /api/contact server proxy.
FORMSPREE_FORM_ID=mzdlannk

# Cloudflare Turnstile secret — only used by /api/contact if you add captcha there later.
TURNSTILE_SECRET_KEY=
